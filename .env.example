# Copy to .env.local to override the defaults in src/data/site.ts.
# Every value is optional; leave a line out to keep the default.

# Phone in international format (used for tel: links)
# NEXT_PUBLIC_CONTACT_PHONE=+250782351635
# How the phone number is shown on the page
# NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+250 782 351 635

# Enquiry email (used for mailto: links and the "send by email" option)
# NEXT_PUBLIC_CONTACT_EMAIL=atlasevmotors@gmail.com

# WhatsApp number: digits only, country code first, no "+"
# NEXT_PUBLIC_WHATSAPP_NUMBER=250782351635
# Set to "true" once the client confirms this number is reachable on WhatsApp
# NEXT_PUBLIC_WHATSAPP_CONFIRMED=false

# Public site URL (metadata / Open Graph)
# NEXT_PUBLIC_SITE_URL=https://example.com

# QA only: set to 1 at BUILD time to expose /dev/full-spec (the vehicle template with every field filled).
# Never set in production; the route returns 404 otherwise.
# NEXT_PUBLIC_ENABLE_DEV_ROUTES=1
